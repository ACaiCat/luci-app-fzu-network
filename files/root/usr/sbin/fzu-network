#!/bin/sh
#
# 福州大学校园网自动认证
#
# 常驻进程模式：进程内部循环按间隔检查在线状态并自动登录，
# 外部命令通过命名管道 (FIFO) 发送给进程，无需 cron。

NAME=fzu-network
# 日志由 init 脚本重定向到 /var/log/fzu-network.log
PID_FILE=/var/run/$NAME.pid
FIFO=/var/run/$NAME.fifo
# 记录下次例行检查的时间戳和当前生效的间隔，供 LuCI 显示
STATE_FILE=/var/run/$NAME.state

DEFAULT_INTERVAL=180 # 默认检查间隔（秒）
MIN_INTERVAL=10

school_no=
password=
user_agent=
interval=

log() {
	echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*"
}

uci_get_by_name() {
	local ret=$(uci get $NAME.$1.$2 2>/dev/null)
	echo ${ret:=$3}
}

uci_bool_by_name() {
	case "$(uci_get_by_name $1 $2)" in
	1 | on | true | yes | enabled) return 0 ;;
	esac
	return 1
}

# 读取（或重新读取）UCI 配置
load_config() {
	school_no=$(uci_get_by_name "base" "school_no")
	password=$(uci_get_by_name "base" "password")
	user_agent=$(uci_get_by_name "base" "user_agent")

	interval=$(uci_get_by_name "base" "interval")

	# 兼容旧版本的 cron 表达式选项 time，例如 "*/3 * * * *" -> 180 秒
	if [ -z "$interval" ]; then
		local cron_min=$(uci_get_by_name "base" "time" | awk '{print $1}')
		case "$cron_min" in
		\*/*) interval=$((${cron_min#*/} * 60)) ;;
		esac
	fi

	case "$interval" in
	'' | *[!0-9]*) interval=$DEFAULT_INTERVAL ;;
	esac
	[ "$interval" -lt "$MIN_INTERVAL" ] && interval=$MIN_INTERVAL

	return 0
}

validate_json() {
	if ! err=$(echo "$1" | jq . 2>&1 >/dev/null); then
		echo "错误: 解析JSON失败: $err"
		return 1
	fi
	return 0
}

# 获取在线状态，输出JSON字符串
get_online_status() {
	local url='http://172.16.0.46/eportal/InterFace.do?method=getOnlineUserInfo'
	local response
	response=$(curl -s -X POST \
		-H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" \
		--data-urlencode "userIndex=" \
		"$url")
	echo "$response"
}

# 检查在线状态
# 返回值: 0=已在线, 1=未在线, 2=等待, 3=请求失败
check_online_status() {
	local online_status
	online_status=$(get_online_status)

	if [ -z "$online_status" ] || ! validate_json "$online_status"; then
		echo "错误: 获取在线状态失败."
		return 3
	fi

	local result
	result=$(echo "$online_status" | jq -r '.result')
	userindex=$(echo "$online_status" | jq -r '.userIndex')
	local message username userid userip usermac
	message=$(echo "$online_status" | jq -r '.message')
	username=$(echo "$online_status" | jq -r '.userName')
	userid=$(echo "$online_status" | jq -r '.userId')
	userip=$(echo "$online_status" | jq -r '.userIp')
	usermac=$(echo "$online_status" | jq -r '.userMac')

	echo "状态: $message | 用户: $username | IP: $userip | MAC: $usermac | 设备ID: $userindex"

	case "$result" in
	success) return 0 ;;
	fail) return 1 ;;
	wait) return 2 ;;
	*) return 3 ;;
	esac
}

get_page_info() {
	local referer_url=$1
	local encoded_query_string=$2
	local JSESSIONID=$3

	local url='http://172.16.0.46/eportal/InterFace.do?method=pageInfo'
	curl -s -X POST \
		-H "Host: 172.16.0.46" \
		-H "Connection: keep-alive" \
		-H "User-Agent: $user_agent" \
		-H "DNT: 1" \
		-H "Accept: */*" \
		-H "Origin: http://172.16.0.46" \
		-H "Referer: $referer_url" \
		-H "Accept-Language: zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6" \
		-H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" \
		--cookie "JSESSIONID=$JSESSIONID" \
		--data-urlencode "queryString=$encoded_query_string" \
		"$url" >/dev/null
}

# 登录
login() {
	# 发送请求并获取页面内容
	local page_content
	page_content=$(curl -s 'http://123.123.123.123')

	# 从页面内容中提取重定向 URL
	local redirect_url
	redirect_url=$(echo "$page_content" | sed -n "s/.*location.href='\([^']*\).*/\1/p")

	if [ -z "$redirect_url" ]; then
		echo "登录失败: 无法获取重定向URL."
		return 1
	fi

	# 使用重定向 URL 获取 JSESSIONID
	local cookie_file
	cookie_file=$(mktemp /tmp/fzu-network-cookies-XXXXXX)
	curl -s -c "$cookie_file" "$redirect_url" -o /dev/null

	local JSESSIONID
	JSESSIONID=$(awk '/JSESSIONID/ {print $7}' "$cookie_file")
	rm -f "$cookie_file"

	# 解析重定向 URL 以获取查询字符串
	local query_string
	query_string=$(echo "$redirect_url" | cut -d'?' -f2-)

	# URL 编码查询字符串
	local encoded_query_string
	encoded_query_string=$(echo "$query_string" | jq -sRr @uri)

	get_page_info "$redirect_url" "$encoded_query_string" "$JSESSIONID"

	local login_url='http://172.16.0.46/eportal/InterFace.do?method=login'
	local response
	response=$(curl -s -X POST \
		-H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" \
		-H "Referer: $redirect_url" \
		-H "Accept-Language: zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6" \
		-H "Accept-Encoding: gzip, deflate" \
		-H "Origin: http://172.16.0.46" \
		-H "DNT: 1" \
		-H "Accept: */*" \
		-H "User-Agent: $user_agent" \
		-H "Connection: keep-alive" \
		-H "Host: 172.16.0.46" \
		--data-urlencode "userId=$school_no" \
		--data-urlencode "password=$password" \
		--data-urlencode "queryString=$encoded_query_string" \
		--data-urlencode "passwordEncrypt=false" \
		--data-urlencode "validcode=" \
		--data-urlencode "operatorUserId=" \
		--data-urlencode "operatorPwd=" \
		--data-urlencode "service=" \
		--cookie "JSESSIONID=$JSESSIONID" \
		"$login_url")

	if validate_json "$response"; then
		local result
		result=$(echo "$response" | jq -r '.result')
		if [ "$result" = "success" ]; then
			echo "登录成功."
			return 0
		else
			local message
			message=$(echo "$response" | jq -r '.message')
			echo "登录失败. 错误信息: $message"
			return 1
		fi
	else
		echo "登录失败. 响应不是有效的JSON."
		return 1
	fi
}

# 执行一轮检查
do_check() {
	log "检查在线状态..."

	check_online_status
	local status=$?

	case $status in
	0)
		log "已在线，无需操作."
		;;
	1)
		log "未在线，尝试登录..."
		login
		;;
	2)
		log "认证状态: 等待中，将在下一个间隔重试."
		;;
	3)
		log "无法访问门户，网络可能不可用."
		;;
	esac
	return $status
}

# ---------------- 命令通道 ----------------

# 处理来自 FIFO 的外部命令，返回非 0 表示要求进程退出
handle_cmd() {
	case "$1" in
	check)
		log "收到命令: check"
		do_check
		;;
	login)
		log "收到命令: login"
		login
		;;
	reload)
		log "收到命令: reload, 正在重新加载配置..."
		load_config
		log "配置已重新加载, 检查间隔 ${interval} 秒."
		;;
	stop | quit | exit)
		log "收到命令: stop"
		return 1
		;;
	"") ;;
	*)
		log "收到未知命令: $1"
		;;
	esac
	return 0
}

# 向守护进程发送命令
send_cmd() {
	local pid
	[ -p "$FIFO" ] || {
		echo "命令管道 $FIFO 不存在, 守护进程未运行." >&2
		return 1
	}
	pid=$(cat "$PID_FILE" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || {
		echo "守护进程未运行." >&2
		return 1
	}
	printf '%s\n' "$1" >"$FIFO"
}

# ---------------- 守护进程 ----------------

daemon_cleanup() {
	rm -f "$PID_FILE" "$FIFO" "$STATE_FILE"
	trap - TERM INT
	exit 0
}

run_daemon() {
	# 定时等待依赖 read -t（busybox ash 支持，超时返回 1）。若这个 shell 不认 -t，
	# 下面的循环会退化成空转并疯狂请求认证服务器，所以先检测、不支持就直接退出。
	read -t 1 __probe </dev/null 2>/dev/null
	if [ $? -gt 1 ]; then
		echo "错误: 当前 shell 不支持 read -t, 无法以守护进程方式运行." >&2
		return 1
	fi

	# 已有实例在运行则拒绝启动（PID 与自身相同时说明是 init 脚本代为写入的）
	local oldpid=$(cat "$PID_FILE" 2>/dev/null)
	if [ -n "$oldpid" ] && [ "$oldpid" != "$$" ] && kill -0 "$oldpid" 2>/dev/null; then
		echo "守护进程已在运行 (PID $oldpid)." >&2
		return 1
	fi

	rm -f "$FIFO"
	mkfifo "$FIFO" || {
		echo "无法创建命令管道 $FIFO." >&2
		return 1
	}
	# 只有 root 能向进程发命令
	chmod 600 "$FIFO"

	# 以读写方式打开管道：open 不会阻塞，且进程存活期间读端不会出现 EOF
	exec 3<>"$FIFO" || {
		rm -f "$FIFO"
		return 1
	}

	echo $$ >"$PID_FILE"
	trap 'daemon_cleanup' TERM INT

	log "守护进程已启动 (PID $$), 检查间隔 ${interval} 秒, 命令管道 ${FIFO}."

	do_check

	local cmd
	while :; do
		# 本轮等待结束时就是下次例行检查的时间
		echo "$(($(date +%s) + interval)) $interval" >"$STATE_FILE"

		cmd=
		if read -t "$interval" cmd <&3; then
			handle_cmd "$cmd" || break
			continue
		fi
		# 超时返回：若残留了未换行的数据则按命令处理，否则执行例行检查
		if [ -n "$cmd" ]; then
			handle_cmd "$cmd" || break
			continue
		fi
		do_check
	done

	log "守护进程退出."
	daemon_cleanup
}

usage() {
	cat <<EOF
用法: $NAME <命令>

  daemon          以守护进程方式运行（由 init 脚本调用）
  check           执行一次在线检查（前台运行）
  login           执行一次登录（前台运行）
  cmd <命令>      向守护进程发送命令
                  命令: check | login | reload | stop
  stop            通知守护进程退出
EOF
}

load_config

case "$1" in
daemon) run_daemon ;;
check | "") do_check ;;
login) login ;;
cmd)
	[ -n "$2" ] || {
		usage
		exit 1
	}
	send_cmd "$2"
	;;
stop) send_cmd stop ;;
help | -h | --help) usage ;;
*)
	usage
	exit 1
	;;
esac

exit $?
