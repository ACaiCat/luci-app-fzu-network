#!/bin/sh

# 旧版 ucitrack (OpenWrt 23.05 及更早) 读取 /etc/config/ucitrack，
# 新版 (24.10+) 改读 /usr/share/ucitrack/*.json，这里写一份以兼容旧版。
uci -q batch <<-EOF >/dev/null
	delete ucitrack.@fzu-network[-1]
	add ucitrack fzu-network
	set ucitrack.@fzu-network[-1].init=fzu-network
	commit ucitrack
EOF

# 旧版本使用 cron 调度, 升级后清理掉遗留的 crontab 条目
if [ -f /etc/crontabs/root ] && grep -q fzu-network /etc/crontabs/root; then
	sed -i '/fzu-network/d' /etc/crontabs/root
	/etc/init.d/cron reload 2>/dev/null
fi

exit 0
